     14, UTC ,CNT
     14, VTM ,1
         : , ITS ,14
         : , UTC ,=1000
         : , AEX ,
         : , U1A ,RET
     14, VTM ,
 RET      : , ITA ,14
         : , UTC ,CNT
         : , STX ,
         : , STI ,14
C******НЕДОПУСТИМЫЙ ОПЕРАТОР (в оригинале  , ПЗ ,UJ,)
         : , END ,
