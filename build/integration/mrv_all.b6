  M CYCL  : , BSS ,
         1, UTC ,2
         1, VTM ,TABL DB .ОПИСАНИЕ ПАКЕТА
         2, VTM ,1       .+1
         2, UTC ,-1
         3, VTM ,        .КОЛИЧ-ВО БЛОКОВ
  BL CYC  : 3, VJM ,EXIT1
         2, XTA ,NUM PS  .НОМЕР ПОДСИСТЕМЫ
           , UTC ,=4
           , AEX ,
           , UZA ,CONT   .НЕ 4-Я
         2, XTA ,A PROG  .АДРЕС ПРОГРАММЫ
           , UZA ,CONT   .НЕТ ПРОГРАММЫ
           , CALL,OKNO
         2, XTA ,PERIOD
         2, UZA ,TO      .ПРИ КАЖДОМ ЗАПУСКЕ
           , ATI ,13
         13, ITA ,CNT
           , XTA ,-1
           , UZA ,CONT   .ЕЩЕ РАНО
           : , BSS ,     .МЕТКА TO определена EQU выше
           , ITA ,1      .НОМЕР МАШИНЫ
           , ITS ,2      .ОПИСАНИЕ БЛОКА
         2, WTC ,A PROG  .АДРЕС ПРОГРАММЫ
         13, VJM ,
           2, UTM ,1     .СЛЕД. ОПИСАНИЕ (МЕТКА CONT = EQU)
         3, ITA ,
           , UJ  ,BL CYC
           1, VLM ,M CYCL .МЕТКА EXIT1 = EQU
