         : , *62 ,47B
         : , UTC ,=7 7777
         : , AEX ,
         : , UZA ,RET
         : , SJ  ,
 RET      : , STI ,
         : , STI ,13
     13, UJ ,
 INF W    : , BSS ,1
         : , END ,
